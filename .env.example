# Copy to .env beside compose.yaml and set paths and addresses for your machine.
# An absolute path is required if WATCHWOLF_MINECRAFT_RUNTIME=legacy.
WATCHWOLF_SERVERS_MANAGER_RELEASE_DIR=../WatchWolf-ServersManager/ci/release
WATCHWOLF_MINECRAFT_RUNTIME=itzg
WATCHWOLF_ITZG_IMAGE=itzg/minecraft-server
WATCHWOLF_ITZG_TAG=auto
WATCHWOLF_MACHINE_IP=127.0.0.1
WATCHWOLF_PUBLIC_IP=127.0.0.1
WATCHWOLF_CLIENTS_IMAGE=clients-manager:latest
