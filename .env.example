# Copy to .env beside compose.yaml and set addresses for your machine.
WATCHWOLF_MINECRAFT_RUNTIME=itzg
WATCHWOLF_ITZG_IMAGE=itzg/minecraft-server
WATCHWOLF_ITZG_TAG=auto
WATCHWOLF_MACHINE_IP=127.0.0.1
WATCHWOLF_PUBLIC_IP=127.0.0.1
WATCHWOLFX_SERVERMANAGER_IMAGE=watchwolfx-servermanager:dev
WATCHWOLFX_CLIENTSMANAGER_IMAGE=watchwolfx-clientsmanager:dev
